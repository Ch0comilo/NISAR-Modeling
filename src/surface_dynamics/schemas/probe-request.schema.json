{
 "$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,
 "required":["contract_version","request_id","dataset_path","longitude","latitude"],
 "properties":{
  "contract_version":{"const":"1.0"},"request_id":{"type":"string","pattern":"^[A-Za-z0-9_-]{1,64}$"},
  "dataset_path":{"type":"string"},"longitude":{"type":"number","minimum":-180,"maximum":180},"latitude":{"type":"number","minimum":-90,"maximum":90},
  "radius_m":{"type":"number","minimum":0,"maximum":5000}
 }
}
