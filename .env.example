# Set these non-secret options in the launching shell. The CLI does not load this file.
NISAR_APP_NAME=nisar-evidence-api
NISAR_VOLUME=nisar-evidence-v2
NISAR_STATE_DICT=nisar-evidence-api-jobs
NISAR_EARTHDATA_SECRET=nisar-explorer-preview
# The secret supplies EARTHDATA_TOKEN inside the Modal science worker.
